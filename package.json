{
  "name": "cyberhoot-assets",
  "private": true,
  "description": "Compilation locale de la feuille de style (Tailwind CSS)",
  "scripts": {
    "build:css": "tailwindcss -i assets/app.css -o app/static/css/app.css --minify",
