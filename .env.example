# Variables facultatives de docker compose (copier en .env si besoin).
# Les secrets ne se mettent PAS ici : `make secrets` les crée dans secrets/.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Port ajouté aux redirections vers HTTPS : « :8443 » en local, vide si HTTPS_PORT=443
HTTPS_SUFFIXE=:8443
PUBLIC_URL=https://localhost:8443
# Cookies réservés à HTTPS (à laisser à true)
COOKIE_SECURE=true
# console (journal) ou smtp
MAIL_BACKEND=console
MAIL_FROM=CyberHoot <no-reply@example.org>
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Analyse antivirus des images : simule (aucun appel réseau) ou virustotal
SCAN_BACKEND=simule
VIRUSTOTAL_API_KEY=
