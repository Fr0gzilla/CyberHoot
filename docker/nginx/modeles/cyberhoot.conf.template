# Gabarit lu au démarrage du conteneur Nginx : ${HTTPS_SUFFIXE} est remplacé par sa valeur
# (« :8443 » en local, vide derrière le port 443). Les variables Nginx ($host…) ne sont pas
# touchées, car elles ne correspondent à aucune variable d'environnement.

upstream cyberhoot_app {
  server app:8000;
  keepalive 16;
}

# HTTP : uniquement une redirection permanente vers HTTPS.
server {
  listen 8080;
  server_name _;

  # Validation Let's Encrypt (méthode HTTP-01), voir docs/https.md.
  location /.well-known/acme-challenge/ {
    root /var/www/acme;
  }

  location / {
    return 301 https://$host${HTTPS_SUFFIXE}$request_uri;
  }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name _;

  ssl_certificate /etc/nginx/tls/cyberhoot.crt;
  ssl_certificate_key /etc/nginx/tls/cyberhoot.key;
  # Profil « intermédiaire » de Mozilla : TLS 1.2 et 1.3, suites modernes uniquement.
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  limit_req_status 429;

  # Feuilles de style, scripts, images : sans limite de débit (une page en charge plusieurs).
  location /static/ {
    proxy_pass http://cyberhoot_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # État d'une partie en direct, interrogé chaque seconde par chaque écran.
  location ~ ^/direct/[0-9]+/etat$ {
    limit_req zone=direct burst=500 nodelay;
    proxy_pass http://cyberhoot_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-ID $request_id;
  }

  location / {
    limit_req zone=par_ip burst=1000 nodelay;
    proxy_pass http://cyberhoot_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    # On remplace (et non complète) les en-têtes transmis : le client ne peut pas les forger.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 30s;
  }
}
